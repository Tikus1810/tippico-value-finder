# Kostenlosen API-Key holen: https://the-odds-api.com/  (Free Tier: 500 Requests/Monat)
ODDS_API_KEY=dein_api_key_hier

# Bookmaker-Key von Tipico bei The Odds API (Stand heute: tipico_de). Nur ändern, falls
# sich der Key mal ändert (siehe https://the-odds-api.com/sports-odds-data/bookmaker-apis.html)
TIPICO_BOOKMAKER_KEY=tipico_de

# Region, in der Tipico gelistet ist
ODDS_API_REGION=eu

# Port des Backend-Servers
PORT=4000

# Wie lange Odds-Antworten im Speicher gecacht werden (Sekunden) - schont dein API-Kontingent
CACHE_TTL_SECONDS=300

# Datenbank: leer lassen für lokale Entwicklung (nutzt automatisch eine lokale Datei,
# backend/data.db). Für einen persistenten Hosting-Betrieb (z.B. Render) hier eine
# Turso-Cloud-Datenbank eintragen (kostenlos, siehe https://turso.tech):
# DATABASE_URL=libsql://dein-db-name-dein-username.turso.io
# DATABASE_AUTH_TOKEN=dein_turso_auth_token
